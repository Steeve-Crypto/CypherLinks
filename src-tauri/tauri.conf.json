{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CypherLinks",
  "version": "0.1.0",
  "identifier": "app.cypherlinks.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CypherLinks",
        "width": 1120,
        "height": 820,
        "minWidth": 760,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "**/*"
          ]
        }
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../browser-extension/manifest.json": "browser-extension/manifest.json",
      "../browser-extension/background.js": "browser-extension/background.js",
      "../browser-extension/popup.html": "browser-extension/popup.html",
      "../browser-extension/popup.js": "browser-extension/popup.js",
      "../browser-extension/popup.css": "browser-extension/popup.css"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "CypherLinks media workflow desktop application",
    "longDescription": "CypherLinks is a local-first desktop application for authorized media downloads, queue management, preview, and transcoding."
  }
}
